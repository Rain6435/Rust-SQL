#!/usr/bin/env bash
set -euo pipefail

# Rust-SQL commit-msg hook: enforces Conventional Commits format.
# Examples:
#   feat(gui): add SQL formatter shortcut
#   fix(adapters): handle empty schema in sqlite
#   refactor: split state slices into modules

MSG_FILE="${1:-}"
if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
    echo "error: commit message file not found." >&2
    exit 1
fi

FIRST_LINE=$(head -n1 "$MSG_FILE" | tr -d '\r')

# Allow git-generated merge, revert, fixup, and squash commits.
if [[ "$FIRST_LINE" =~ ^(Merge\ |Revert\ \"|fixup!\ |squash!\ ) ]]; then
    exit 0
fi

PATTERN='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9_./-]+\))?(!)?: .{1,100}$'
if [[ ! "$FIRST_LINE" =~ $PATTERN ]]; then
    echo "error: invalid commit message header: '$FIRST_LINE'" >&2
    echo "Expected Conventional Commits format: <type>[optional (scope)]: <description>" >&2
    echo "Allowed types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert" >&2
    exit 1
fi
